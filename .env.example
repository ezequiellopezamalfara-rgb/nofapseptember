# Supabase — proyecto del challenge
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso a la app (código de acceso compartido, elegido por quien despliega)
VITE_ACCESS_CODE=

# Pepper para el hash del PIN. NO lleva prefijo VITE_: nunca se manda al
# cliente, el hash se calcula server-side dentro de claim_user() (ver
# supabase/schema.sql). Después de correr el schema, configurarlo una vez con
# el mismo valor:
#   insert into app_config (key, value) values ('pin_pepper', '<este valor>');
PIN_PEPPER=

# Web Push (VAPID) — generar con `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuemail@ejemplo.com

# Protege /api/cron/reminders (Vercel Cron manda este valor como Bearer token)
CRON_SECRET=
